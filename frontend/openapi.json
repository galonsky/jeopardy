  "components": {
    "schemas": {
      "PracticePresetInput": {
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionMode"
              }
            ],
            "default": "general"
          },
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "title": "PracticePresetInput",
        "type": "object"
      },
      "SessionMode": {
        "enum": [
          "anytime",
          "general",
          "weak_areas",
          "review"
        ],
        "title": "SessionMode",
        "type": "string"
      },
      "ClassificationJobInput": {
        "properties": {
          "version": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaxonomyVersion"
              }
            ],
            "default": "v1"
          },
          "limit": {
            "default": 0,
            "minimum": 0,
            "title": "Limit",
            "type": "integer"
          },
          "concurrency": {
            "default": 2,
            "maximum": 16,
            "minimum": 1,
            "title": "Concurrency",
            "type": "integer"
          },
          "clue_ids": {
            "items": {
              "type": "string"
            },
            "title": "Clue Ids",
            "type": "array"
          },
          "reprocess": {
            "default": false,
            "title": "Reprocess",
            "type": "boolean"
          }
        },
        "title": "ClassificationJobInput",
        "type": "object"
      },
      "TaxonomyVersion": {
        "enum": [
          "v1"
        ],
        "title": "TaxonomyVersion",
        "type": "string"
      },
      "StartSession": {
        "properties": {
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionMode"
              }
            ],
            "default": "general"
          },
          "count": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Count",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "min_difficulty": {
            "default": 1,
            "maximum": 5,
            "minimum": 1,
            "title": "Min Difficulty",
            "type": "integer"
          },
          "max_difficulty": {
            "default": 5,
            "maximum": 5,
            "minimum": 1,
            "title": "Max Difficulty",
            "type": "integer"
          },
          "difficulty_weights": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Difficulty Weights",
            "type": "object"
          },
          "subject_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Subject Ids",
            "type": "array"
          },
          "subtopic_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Subtopic Ids",
            "type": "array"
          },
          "include_double": {
            "default": true,
            "title": "Include Double",
            "type": "boolean"
          },
          "include_daily_doubles": {
            "default": false,
            "title": "Include Daily Doubles",
            "type": "boolean"
          },
          "include_final": {
            "default": false,
            "title": "Include Final",
            "type": "boolean"
          },
          "include_media_required": {
            "default": false,
            "title": "Include Media Required",
            "type": "boolean"
          },
          "min_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Date"
          },
          "max_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Date"
          },
          "timer_seconds": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimerDuration"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "StartSession",
        "type": "object"
      },
      "TimerDuration": {
        "enum": [
          15,
          30,
          60
        ],
        "title": "TimerDuration",
        "type": "integer"
      },
      "RecallRating": {
        "enum": [
          "confident",
          "guessed",
          "did_not_know"
        ],
        "title": "RecallRating",
        "type": "string"
      },
      "RecallRatingInput": {
        "properties": {
          "rating": {
            "$ref": "#/components/schemas/RecallRating"
          }
        },
        "required": [
          "rating"
        ],
        "title": "RecallRatingInput",
        "type": "object"
      },
      "AnswerInput": {
        "properties": {
          "answer": {
            "default": "",
            "title": "Answer",
            "type": "string"
          },
          "response_ms": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Ms"
          },
          "position": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          }
        },
        "title": "AnswerInput",
        "type": "object"
      },
      "AttemptGrade": {
        "enum": [
          "correct",
          "partial",
          "incorrect",
          "uncertain",
          "unanswered"
        ],
        "title": "AttemptGrade",
        "type": "string"
      },
      "GradeInput": {
        "properties": {
          "correctness": {
            "$ref": "#/components/schemas/AttemptGrade"
          }
        },
        "required": [
          "correctness"
        ],
        "title": "GradeInput",
        "type": "object"
      }
    }
  },
  "servers": []
}