{
  "name": "jeopardy-study-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "orval": "^8.4.0",
    "oxfmt": "^0.17.0",
    "oxlint": "^1.20.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
